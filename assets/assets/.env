# ──────────────────────────────────────────────────
# Fixly App — Environment Variables
# ──────────────────────────────────────────────────
# ВАЖНО: Добавьте этот файл в .gitignore!
# Не коммитьте реальные ключи в репозиторий.
# ──────────────────────────────────────────────────

# YOLOv8 FastAPI backend
# Для локального тестирования на Android-эмуляторе: http://10.0.2.2:8000
# Для iOS симулятора: http://localhost:8000
# Для продакшн: ваш реальный URL
YOLO_API_URL=https://your-yolo-api.fixly.kz

# Таймаут запроса к YOLO API (в секундах)
YOLO_TIMEOUT_SECONDS=20

# Порог уверенности детекции (0.0 – 1.0)
YOLO_CONFIDENCE_THRESHOLD=0.4

# Максимальное количество детекций на одно фото
YOLO_MAX_DETECTIONS=10
